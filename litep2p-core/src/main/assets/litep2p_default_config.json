    "anomaly_reporter": {
        "enabled": true,
        "directory": "anomalies",
        "max_files": 200,
        "upload_enabled": false,
        "upload_url": "",
        "upload_interval_ms": 300000,
        "include_telemetry": true,
        "stall_threshold_ms": 60000,
        "min_interval_ms": 60000,
        "max_per_type_per_hour": 10
    }
