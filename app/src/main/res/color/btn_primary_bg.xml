<?xml version="1.0" encoding="utf-8"?>
<!--
    Start button background.

    A disabled Start must not look like an enabled one. Material's default disabled
    tint is barely distinguishable on a dark surface, so the disabled state is
    explicitly flattened toward the card colour here.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/accent_disabled" />
    <item android:state_pressed="true" android:color="@color/accent_pressed" />
    <item android:color="@color/accent" />
</selector>
