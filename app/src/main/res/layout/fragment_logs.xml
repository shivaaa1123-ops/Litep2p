<?xml version="1.0" encoding="utf-8"?>
<!--
    Logs tab: severity filter chips + line counter on top of the console stream.
    Filtering is purely presentational; the underlying log buffer is untouched.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_filter"
            android:importantForAccessibility="no"
            app:tint="@color/text_tertiary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/logFilterGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/logFilterAll"
                style="@style/Widget.LiteP2P.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logs_filter_all"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/logFilterWarnings"
                style="@style/Widget.LiteP2P.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logs_filter_warnings" />

            <com.google.android.material.chip.Chip
                android:id="@+id/logFilterErrors"
                style="@style/Widget.LiteP2P.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logs_filter_errors" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/logCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0"
            android:fontFamily="monospace"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logsRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Empty state for the filtered/unfiltered stream. -->
        <TextView
            android:id="@+id/logsEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/logs_empty_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>