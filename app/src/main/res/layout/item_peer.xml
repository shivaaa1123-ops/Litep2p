<?xml version="1.0" encoding="utf-8"?>
<!--
    Peer row: a modern card with a status dot, the peer identity, and an explicit
    Connect / Send action. The whole row is tappable (connect when idle, send when
    ready) and long-press copies the peer ID.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LiteP2P.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <View
            android:id="@+id/peerStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/peerIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/peerMetaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peerActionButton"
            style="@style/Widget.LiteP2P.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Connect"
            app:icon="@drawable/ic_play"
            app:iconPadding="6dp"
            app:iconTint="@color/text_secondary"
            android:textColor="@color/text_secondary" />

        <!-- File-transfer action: only meaningful for ready peers (shown/hidden by
             the adapter). Launches the system photo picker. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/peerFileButton"
            style="@style/Widget.LiteP2P.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="File"
            android:visibility="gone"
            app:icon="@drawable/ic_file"
            app:iconPadding="6dp"
            app:iconTint="@color/text_secondary"
            android:textColor="@color/text_secondary" />

        <!-- Voice-call action (LiteCall): only for ready peers. Starts a realtime
             audio call; requires RECORD_AUDIO permission. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/peerCallButton"
            style="@style/Widget.LiteP2P.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Call"
            android:visibility="gone"
            app:icon="@drawable/ic_phone"
            app:iconPadding="6dp"
            app:iconTint="@color/text_secondary"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>