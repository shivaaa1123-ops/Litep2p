<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen: slim app bar, engine control panel, collapsible peers section and the
    dashboard pager (Logs / Messages / Telemetry / Resources).

    The root applies the system-bar insets (edge-to-edge is enabled in MainActivity),
    while the inner content applies the navigation-bar inset so nothing is drawn
    under the gesture bar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_0">

    <!-- App bar: identity on the left, console actions on the right. -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_0"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:background="@drawable/bg_empty_circle"
            android:src="@drawable/ic_terminal"
            android:contentDescription="@string/app_name"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.LiteP2P.Title"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- One tap clears the whole console: logs, messages and traces. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearConsoleButton"
            style="@style/Widget.LiteP2P.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_clear_console"
            android:tooltipText="@string/action_clear_console"
            app:icon="@drawable/ic_clear" />

    </LinearLayout>

    <!-- Include the header with IP and status -->
    <include layout="@layout/header_layout" />

    <!--
        Collapsible peers section.

        The peers list and the log stream compete for a small screen. Giving peers a
        header that reports its own count means the list can be collapsed when the user
        is reading logs, without losing sight of how many peers are connected.
    -->
    <LinearLayout
        android:id="@+id/peersSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/peers_section_title"
            android:textAppearance="@style/TextAppearance.LiteP2P.Label" />

        <TextView
            android:id="@+id/peersCountBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/peers_none_discovered"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/peersChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_down"
            android:rotation="180"
            android:contentDescription="Toggle peers list"
            app:tint="@color/text_tertiary" />

    </LinearLayout>

    <!-- Container for the HomeFragment (Peers List) -->
    <FrameLayout
        android:id="@+id/home_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/peers_panel_height" />

    <!-- Container for the LogsFragment -->
    <FrameLayout
        android:id="@+id/logs_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>