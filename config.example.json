{
        /*
            Example config for LiteP2P.

            IMPORTANT:
            - Do NOT commit real TURN credentials or private infrastructure endpoints to git.
            - For GitHub self-hosted runners, place your real config at:
                /etc/litep2p/config.json
              (or adjust the workflow CONFIG_PATH accordingly).
        */
    "network": {
        "default_server_port": 30001,
        "discovery_port": 30000,
        /* discovery_enabled: LAN broadcast discovery master switch. Default
           true. Set false to run purely on signaling/peer-DB/direct endpoints
           (or for hermetic test environments). */
        "discovery_enabled": true,
        "listen_backlog": 5,
        "select_max_retries": 3,

        /* v0.4 censorship resistance.
           - port_range: when set to [min, max], the engine picks a RANDOM free
             port in this range for its data listener at startup (instead of a
             fixed port), so a static port blocklist cannot pin it down. The
             real port is advertised via discovery/signaling, so peers still
             find this node. Omit/disable to keep the fixed default port.
           - discovery_magic: prefix bytes on LAN discovery announcements.
             Set a random per-deployment string so packets are NOT recognizable
             as "LITEP2P_DISCOVERY". Keep the default for interoperability with
             unmodified deployments.
           - discovery_shared_key: 64-hex-char AEAD key. When set, discovery
             announcements are encrypted (XChaCha20-Poly1305) and padded, so
             peer ids/ports are opaque to passive observers. ALL nodes in a
             deployment must use the SAME magic + key. */
        "port_range": [31000, 32000],
        "discovery_magic": "LITEP2P_DISCOVERY",
        "discovery_shared_key": ""
    },
    "communication": {
        "default_protocol": "UDP",
        "quic": {
            "enabled": true,
            "port": 30001,
            "buffer_size": 1048576
        },
        "udp": {
            "enabled": true,
            "port": 30001,
            "buffer_size": 65535,
            "timeout_ms": 5000,
            "select_timeout_sec": 1
        },
        "tcp": {
            "enabled": true,
            "port": 30001,
            "nodelay": true,
            "buffer_size": 4096,
            "connect_timeout_sec": 5,
            "select_timeout_sec": 1
        }
    },
    "peer_management": {
        "peer_timeout_sec": 30,
        "timer_tick_interval_sec": 10,
        "ping_interval_sec": 10,
        "heartbeat_interval_sec": 10,
        "peer_expiration_timeout_ms": 30000,
        "max_queued_messages": 100,
        "max_pending_sends": 1000,
        "max_message_size": 10485760,
        "max_handshake_retries": 3
    },
    "discovery": {
        "message_prefix": "LITEP2P_DISCOVERY",
        "max_message_size": 1024,
        "broadcast_interval_sec": 5
    },
    "security": {
        "transport_key": "",
        "noise_nk_protocol": {
            "enabled": true,
            "mandatory": true,
            "key_store_path": "keystore",
            "key_rotation_interval_hours": 24
        },
        "selective_encryption_enabled": true
    },
    "batch_connection_manager": {
        "enabled": true,
        "max_peers_per_batch": 10,
        "max_batches": 5,
        "batch_delay_ms": 100,
        "batch_max_messages": 50,
        "cleanup_interval_ms": 60000
    },
    "session_manager": {
        "num_workers": 4,
        "cache_size": 100,
        "cache_lifetime_sec": 3600,
        "session_timeout_ms": 30000,
        "max_concurrent_sessions": 100
    },
    "event_manager": {
        "queue_wait_timeout_ms": 100,
        "timer_tick_interval_ms": 500,
        "thread_sleep_ms": 100
    },
    "performance": {
        "event_thread_pool_workers": 4,
        "message_batcher_enabled": true,
        "session_caching_enabled": true,
        "buffer_pool_size": 16,
        "cleanup_thread_sleep_sec": 10,
        "shutdown_delay_ms": 100
    },
    "battery_optimizer": {
        "enabled": true,
        "aggressive_mode": false,
        "power_save_threshold": 20,
        "level_critical": 10,
        "level_low": 20,
        "level_medium": 80
    },
    "reconnect_policy": {
        "mode": "auto",
        "max_backoff_level": 16,
        "max_consecutive_failures": 5,
        "default_backoff_ms": 30000,
        "initial_backoff_ms": 500,
        "max_backoff_ms": 60000
    },
    "network_quality": {
        "rtt_excellent_ms": 50,
        "rtt_good_ms": 150,
        "rtt_poor_ms": 300,
        "rtt_bad_ms": 1000,
        "packet_loss_low": 0.01,
        "packet_loss_medium": 0.05,
        "packet_loss_high": 0.20
    },
    "tier_system": {
        "latency_sample_size": 20,
        "max_error_history": 1000,
        "max_recovery_attempts": 5,
        "quarantine_time_sec": 300,
        "memory_usage_threshold": 90.0,
        "error_check_window_sec": 60
    },
    "nat_traversal": {
        "enabled": true,
        "mode": "auto",
        "stun_enabled": true,
        "stun_timeout_ms": 2000,
        "upnp_enabled": false,
        "upnp_timeout_ms": 5000,
        "upnp_lease_duration_sec": 3600,
        "hole_punching_enabled": true,
        "hole_punch_max_attempts": 5,
        "hole_punch_retry_backoff_ms": 100,
        "hole_punch_thread_pool_size": 10,
        "heartbeat_interval_sec": 15,
        "cleanup_interval_sec": 60,
        "heartbeat_timeout_ms": 45000,
        "max_external_port_attempts": 10,
        "turn_enabled": true,
        "turn_config": {
            "server_ip": "TURN_SERVER_IP",
            "server_port": 3478,
            "username": "TURN_USERNAME",
            "password": "TURN_PASSWORD",
            "realm": "TURN_REALM"
        },
        "stun_servers": [
            {"hostname": "stun.l.google.com", "port": 19302},
            {"hostname": "stun1.l.google.com", "port": 19302},
            {"hostname": "stun.stunprotocol.org", "port": 3478}
        ],
        "peer_discovery": {
            "enabled": true,
            "discovery_interval_ms": 5000,
            "max_peer_cache": 100,
            "verified_peer_timeout_ms": 300000
        }
    },
    "signaling": {
        "enabled": true,
        /* Use wss:// URLs for TLS-encrypted signaling (desktop build links
           OpenSSL; the Android AAR currently requires ws:// until a TLS stack
           is vendored). Serving signaling over wss://:443 makes it look like
           ordinary HTTPS traffic and defeats IP/port-level blocking. */
        "url": "wss://SIGNALING_HOST",
        "reconnect_interval_ms": 5000
    },
    "proxy": {
        "enable_gateway": false,
        "enable_client": true,
        "enable_test_echo": false
    },
    "overlay": {
        /*
            Multi-hop overlay routing (LPX2) — censorship resistance.

            SECURE BY DEFAULT (0.3.0): transport obfuscation, length padding,
            and origin authentication ship ENABLED. Every knob below is an
            OPT-OUT; omit the whole section to keep the secure defaults.
            See docs/censorship-resistance.md for the full behavior spec.

            - obfuscate_transport: wraps every outgoing overlay frame in an
              OBF1 envelope (X25519 + XChaCha20-Poly1305) so the "LPX2" magic
              is never visible on the wire. Incoming frames are auto-detected
              by magic, so plain LPX2 frames from older/relaxed peers are
              still accepted (mixed-config interop).
            - padding_bucket: pads frames to multiples of this many bytes,
              hiding real message lengths from DPI. 128 keeps the worst-case
              frame (1216 B) under the IPv6 minimum MTU (1280 B). 0 disables.
            - cover_interval_ms: relay-role nodes emit dummy cover frames
              after this much idle time, obscuring silence/presence patterns.
              Only nodes with relay_enabled=true ever emit cover traffic, so
              default (non-relay) clients pay no cost. 0 disables.
            - pex_interval_ms: relay-list exchange period; relay knowledge
              spreads peer-to-peer without any central directory. 0 disables.
            - require_origin_auth: drop overlay payloads without a valid
              Ed25519 origin signature. All 0.3.0 nodes auto-generate signing
              keys and sign every payload, so this breaks no legitimate
              traffic. Set false only to interoperate with pre-Phase-B peers.
            - relay_enabled: forwarding frames / holding mailboxes for other
              peers stays OPT-IN (default false), matching the proxy-gateway
              policy. Origin/destination roles need no opt-in.
        */
        "relay_enabled": false,
        "default_hops": 2,
        "relay_peers": [],
        "obfuscate_transport": true,
        "padding_bucket": 128,
        "cover_interval_ms": 30000,
        "pex_interval_ms": 60000,
        "require_origin_auth": true
    },
    "global_discovery": {
        "enabled": false,
        "discovery_strategy": "broadcast",
        "local_network_scan": true,
        "announce_self": true,
        "announce_interval_ms": 30000,
        "bootstrap_nodes": []
    },
    "logging": {
        "level": "debug",
        "format": "text",
        "file_path": "litep2p.log",
        "max_file_size_mb": 10,
        "retention_days": 7,
        "console_output": true
    },
    "monitoring": {
        "enabled": false,
        "metrics_port": 9090,
        "health_check_interval_ms": 30000
    },
    /* v0.4 field diagnostics: writes a structured incident file for every
       anomaly (disconnect, connect failure, stall that did not recover, runtime
       error) into <filesDir|CWD>/anomalies/ so it can be inspected via terminal
       or adb. Each incident carries timestamp, engine uptime, peer/endpoint,
       device info (brand/model/os/abi), engine version and a telemetry snapshot.

       Production: set upload_enabled + upload_url and the engine periodically
       POSTs pending incident files (plain HTTP for now; HTTPS in the TLS phase)
       to your collector server, then deletes the uploaded files. Failed uploads
       stay pending and are retried next interval, capped by max_files. */
    "anomaly_reporter": {
        "enabled": true,
        "directory": "anomalies",
        "max_files": 200,
        "upload_enabled": false,
        "upload_url": "http://YOUR_COLLECTOR_HOST:8899/ingest",
        "upload_interval_ms": 300000,
        "include_telemetry": true,
        "stall_threshold_ms": 60000,
        /* Dedup / rate limiting (production resource guard):
           - min_interval_ms: the same (type + peer + detail) incident is logged
             at most once per this window; repeats are folded into
             `suppressed_count` on the next written incident.
           - max_per_type_per_hour: cap per event_type per rolling hour.
           Keeps incident files small even when an error repeats constantly. */
        "min_interval_ms": 60000,
        "max_per_type_per_hour": 10
    },
    "remote_control": {
        "enabled": false,
        "allowed_senders": []
    },
    "storage": {
        "peer_db": {
            "enabled": false,
            "path": "",
            "reconnect_candidate_limit": 2000,
            "prune_after_days": 15
        }
    }
}


